datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector", schema: "extensions"), pg_stat_statements, pgcrypto, supabase_vault, uuid_ossp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  ADMIN
  AGENT
  AUDITOR
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  VERIFIED
  CLEARED
}

enum RegulatoryStatus {
  UNKNOWN
  REGULATED
  NON_REGULATED
  RESTRICTED
  PROHIBITED
}

model Profile {
  id        String     @id // References auth.users.id from Supabase Auth
  fullName  String?
  role      Role       @default(AGENT)
  invoices  Invoice[]
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("profiles")
}

model Invoice {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber String            @db.VarChar(100)
  exporterName  String            @db.VarChar(255)
  importerName  String            @db.VarChar(255)
  currency      String            @default("SAR") @db.VarChar(3)
  totalAmount   Decimal           @db.Decimal(14, 2)
  charges       Json?
  storagePath   String            // Private Supabase Storage object path (e.g., "invoices/2026/inv_01.pdf")
  fileHash      String            @db.Char(64) // SHA-256 integrity hash
  status        InvoiceStatus     @default(PENDING)
  createdById   String
  createdBy     Profile           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lineItems     InvoiceLineItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([invoiceNumber])
  @@index([createdById])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId            String           @db.Uuid
  invoice              Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNumber           Int
  description          String           @db.Text
  quantity             Decimal          @db.Decimal(12, 3)
  unitValue            Decimal          @db.Decimal(14, 4)
  totalValue           Decimal          @db.Decimal(14, 2)
  countryOfOrigin      String           @db.Char(2) // ISO-2 Country Code (e.g., "CN", "DE", "US")
  declaredHsCode       String?          @db.VarChar(12)
  matchedHsCode        String?          @db.VarChar(12) // Official ZATCA 12-digit code
  dutyRate             Decimal?         @db.Decimal(5, 2)
  vatRate              Decimal          @default(15.00) @db.Decimal(5, 2)
  calculatedDutyFee    Decimal?         @db.Decimal(14, 2)
  calculatedVatFee     Decimal?         @db.Decimal(14, 2)
  regulatoryStatus     RegulatoryStatus @default(UNKNOWN)
  classificationEvidence Json?
  requiredCertificates String[]         // Saber/Tabseer flags: ["PCoC", "SCoC", "G-Mark", "IECEE", "SFDA"]
  confidenceScore      Float?           // AI similarity matching score (0.00 to 1.00)
  verifiedByUser       Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([invoiceId])
  @@index([matchedHsCode])
  @@index([regulatoryStatus])
  @@map("invoice_line_items")
}

model SaudiTariffCatalog {
  id               String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hsCode           String                        @unique @db.VarChar(12)
  descriptionEn    String                        @db.Text
  descriptionAr    String                        @db.Text
  dutyRate         Decimal                       @db.Decimal(5, 2)
  isRegulated      Boolean                       @default(false)
  requiredRegs     String[]                      // SASO Technical Regulations
  embedding        Unsupported("vector(1536)")?  // Embeddings for OpenAI/Supabase semantic search
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@index([hsCode])
  @@map("saudi_tariff_catalog")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String   @db.VarChar(100) // e.g., "HS_CODE_OVERRIDDEN", "BATCH_CLEARED"
  entityType String   @db.VarChar(50)  // "Invoice" | "InvoiceLineItem"
  entityId   String   @db.Uuid
  details    Json?    // Snapshot of change payloads
  ipAddress  String?  @db.VarChar(45)
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}
